@model Agro_Mercado.AppMVC.Models.ProductoPresentacion

<div class="form-create-container">

    <div class="form-create-card">

        <h4 class="titulo-agro mb-4 text-danger">🗑️ Eliminar Presentación</h4>

        <p class="mb-4">
            ¿Seguro que deseas eliminar esta presentación?
        </p>

        <div class="row">
            <div class="col-md-12">
                <div class="card mt-3">
                    <div class="card-body">

                        <p>
                            <strong>Producto:</strong> @Model.Producto?.Nombre
                        </p>

                        <p>
                            <strong>Nombre:</strong> @Model.Nombre
                        </p>

                        <p>
                            <strong>Equivalencia:</strong> @Model.Equivalencia
                        </p>

                        <p>
                            <strong>Tipo:</strong> @Model.Tipo
                        </p>

                        <p>
                            <strong>Estado:</strong> @(Model.Activo ? "Activo" : "Inactivo")
                        </p>

                    </div>
                </div>
            </div>
        </div>

        <form asp-action="DeleteConfirmed" method="post" class="mt-4">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div class="d-flex justify-content-end gap-2">

                <button type="submit" class="btn btn-danger px-4">
                    Eliminar
                </button>

                <a asp-action="Index" class="btn btn-secondary px-4">
                    Cancelar
                </a>

            </div>

        </form>

    </div>
</div>