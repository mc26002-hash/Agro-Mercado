@model Agro_Mercado.AppMVC.Models.ProductoPresentacion

<div class="form-create-container">

    <div class="form-create-card">

        <h4 class="titulo-agro mb-4">📄 Detalle de Presentación</h4>

        <div class="row">
            <div class="col-md-12">
                <div class="card mt-3">

                    <div class="card-body">

                        <p>
                            <strong>Producto:</strong> @Model.Producto?.Nombre
                        </p>

                        <p>
                            <strong>Nombre:</strong> @Model.Nombre
                        </p>

                        <p>
                            <strong>Equivalencia:</strong> @Model.Equivalencia
                        </p>

                        <p>
                            <strong>Tipo:</strong> @Model.Tipo
                        </p>

                        <p>
                            <strong>Estado:</strong> @(Model.Activo ? "Activo" : "Inactivo")
                        </p>

                    </div>
                </div>

            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4">
                Editar
            </a>

            <a asp-action="Index" class="btn btn-secondary px-4">
                Volver
            </a>

        </div>

    </div>
</div>