@model Agro_Mercado.AppMVC.Models.Cliente

<div class="form-create-container">

    <div class="form-create-card">

        <h4 class="titulo-agro mb-4">👤 Nuevo Cliente</h4>

        <form asp-action="Create" method="post">

            <div class="row">

                <!-- 🔹 Nombre -->
                <div class="col-md-12 mb-3">
                    <label class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control input-agro" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <!-- 🔹 DUI -->
                <div class="col-md-6 mb-3">
                    <label class="form-label">DUI</label>
                    <input asp-for="Dui" class="form-control input-agro" placeholder="00000000-0" />
                    <span asp-validation-for="Dui" class="text-danger"></span>
                </div>

                <!-- 🔹 Teléfono -->
                <div class="col-md-6 mb-3">
                    <label class="form-label">Teléfono</label>
                    <input asp-for="Telefono" class="form-control input-agro" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>

                <!-- 🔹 Dirección -->
                <div class="col-md-12 mb-3">
                    <label class="form-label">Dirección</label>
                    <input asp-for="Direccion" class="form-control input-agro" />
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>

                <!-- 🔹 Estado -->
                <div class="col-md-6 mb-3">
                    <label class="form-label">Activo</label>
                    <select asp-for="Activo" class="form-select input-agro">
                        <option value="true">Activo</option>
                        <option value="false">Inactivo</option>
                    </select>
                </div>

            </div>

            <!-- 🔘 BOTONES -->
            <div class="d-flex justify-content-end gap-2 mt-4">

                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-plus-lg me-2"></i>Guardar
                </button>

                <a asp-action="Index" class="btn btn-secondary px-4">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}