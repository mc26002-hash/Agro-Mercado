@model Agro_Mercado.AppMVC.Models.Venta

<div class="agrocmp-container">

    <h2 class="agrocmp-title text-center mb-4">🗑️ Eliminar Venta</h2>

    
    <div class="alert alert-danger text-center">
        ¿Estás seguro que deseas eliminar esta venta? Esta acción devolverá el stock.
    </div>

    <form asp-action="DeleteConfirmed" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        
        <div class="row">
            <div class="col-md-6">
                <div class="agrocmp-card mb-3">
                    <p><strong>Cliente:</strong> @Model.Cliente?.Nombre</p>
                    <p><strong>Empleado:</strong> @Model.Empleado?.Nombre</p>
                    <p><strong>Método de Pago:</strong> @Model.MetodoPago</p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="agrocmp-card mb-3 text-end">
                    <p><strong>Factura:</strong> @Model.NumeroFactura</p>
                    <p><strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy")</p>
                </div>
            </div>
        </div>

        <hr />

       
        <h5 class="agrocmp-title mb-3">🛒 Productos</h5>

        <div class="agrocmp-card">
            <div class="table-responsive">
                <table class="table table-bordered agrocmp-table text-center align-middle">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Presentación</th>
                            <th>Cantidad</th>
                            <th>Precio</th>
                            <th>SubTotal</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.DetalleVenta)
                        {
                            <tr>
                                <td>@item.Producto?.Nombre</td>
                                <td>@item.ProductoPresentacion?.Nombre</td>
                                <td>@item.Cantidad</td>
                                <td>$@item.Precio.ToString("0.00")</td>
                                <td>$@item.SubTotal.ToString("0.00")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <hr />

        
        <div class="row justify-content-end">
            <div class="col-md-4">
                <div class="agrocmp-card text-end">
                    <p><strong>SubTotal:</strong> $@Model.SubTotal.ToString("0.00")</p>
                    <p><strong>IVA:</strong> $@Model.Iva.ToString("0.00")</p>
                    <h5><strong>Total:</strong> $@Model.Total.ToString("0.00")</h5>
                </div>
            </div>
        </div>

       
        <div class="mt-4 text-end">

            <button type="submit" class="btn btn-danger me-2">
                <i class="bi bi-trash me-1"></i>Eliminar
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-x-circle me-1"></i>Cancelar
            </a>

        </div>

    </form>

</div>