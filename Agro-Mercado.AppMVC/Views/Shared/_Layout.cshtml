@inject Agro_Mercado.AppMVC.Models.AgroMercadoSprintContext _context

@{
    var rolId = Context.Session.GetInt32("RolId");
}

@{
    var productosBajoStock = _context.Productos
        .Where(p => p.Stock <= p.StockMinimo && p.Activo == true)
        .ToList();

    var totalAlertas = productosBajoStock.Count;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgroMercado</title>

    <!-- Bootstrap PRIMERO -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- TU CSS AL FINAL 🔥 -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            body {
                background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('https://images.unsplash.com/photo-1500382017468-9049fed747ef');
                background-size: cover;
                background-position: center;
                background-attachment: fixed;
            }

            /* SIDEBAR */
            .sidebar {
                width: 240px;
                height: 100vh;
                position: fixed;
                background: #2e7d32;
                color: white;
                padding-top: 20px;
            }

                .sidebar h4 {
                    text-align: center;
                    font-weight: bold;
                    margin-bottom: 30px;
                }

                /* LINKS GENERALES DEL SIDEBAR */
                .sidebar a,
                .menu-opciones a {
                    display: block;
                    color: white;
                    padding: 12px 20px;
                    text-decoration: none;
                    border-radius: 5px;
                    transition: all 0.3s ease;
                }

                    /* HOVER UNIFICADO */
                    .sidebar a:hover,
                    .menu-opciones a:hover,
                    .menu-titulo:hover {
                        background-color: rgba(255,255,255,0.15);
                        padding-left: 25px;
                    }

                /* ICONOS */
                .sidebar i,
                .menu-opciones i {
                    margin-right: 10px;
                }

            /* CONTENIDO */
            .content {
                margin-left: 240px;
                padding: 20px;
            }

            main {
                background: white;
                padding: 25px;
                border-radius: 12px;
                box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            }

            h2 {
                color: #2e7d32;
                font-weight: bold;
            }

            /* FOOTER */
            footer {
                margin-top: 40px;
                text-align: center;
                color: gray;
            }

            /* MENÚ MODULAR */
            .menu-modulo {
                margin-bottom: 10px;
            }

            /* BOTÓN DE MÓDULO */
            .menu-titulo {
                width: 100%;
                background: #2e7d32;
                color: white;
                border: none;
                padding: 12px 20px;
                text-align: left;
                font-weight: bold;
                cursor: pointer;
                border-radius: 5px;
                transition: all 0.3s ease;
            }

            /* CONTENIDO DEL MÓDULO */
            .menu-opciones {
                display: none;
                flex-direction: column;
                background: #1b5e20;
                padding: 10px;
                border-radius: 5px;
                margin-top: 5px;
            }

                /* LINKS DENTRO DEL MÓDULO */
                .menu-opciones a {
                    padding: 10px;
                }

                    /* HOVER MÁS SUAVE PARA OPCIONES */
                    .menu-opciones a:hover {
                        background-color: rgba(255,255,255,0.2);
                    }
    </style>
</head>

<body>

    <!-- 🌱 SIDEBAR -->
    <div class="sidebar">
        <h4>🌾 AgroMercado</h4>
        
        <a asp-controller="Home" asp-action="Index">
            <i class="bi bi-house"></i> Inicio
        </a>
        
        <!-- 👥 GESTIÓN DE PERSONAS (SOLO ADMIN) -->
        @if (rolId == 1)
        {
            <div class="menu-modulo">
                <button class="menu-titulo">
                    <i class="bi bi-people-fill"></i> Gestión de Personas
                </button>

                <div class="menu-opciones">
                    <a asp-controller="Empleado" asp-action="Index">
                        <i class="bi bi-person-badge"></i> Empleados
                    </a>

                    <a asp-controller="Role" asp-action="Index">
                        <i class="bi bi-shield-lock"></i> Roles
                    </a>
                </div>
            </div>
        }

        <!-- 📦 INVENTARIO (ADMIN + COMPRAS + INVENTARIO) -->
        @if (rolId == 1 || rolId == 6 || rolId == 9)
        {
            <div class="menu-modulo">
                <button class="menu-titulo">
                    <i class="bi bi-box-seam"></i> Inventario
                </button>

                <div class="menu-opciones">
                    <a asp-controller="Categorias" asp-action="Index">
                        <i class="bi bi-tags"></i> Categorías
                    </a>

                    <a asp-controller="UnidadesMedida" asp-action="Index">
                        <i class="bi bi-rulers"></i> Unidades
                    </a>

                    <a asp-controller="Producto" asp-action="Index">
                        <i class="bi bi-box"></i> Productos
                    </a>

                    <a asp-controller="ProductoPresentacion" asp-action="Index">
                        <i class="bi bi-boxes"></i> Presentaciones
                    </a>

                    <a asp-controller="MovimientosInventario" asp-action="Index">
                        <i class="bi bi-arrow-left-right"></i> Movimientos
                    </a>
                </div>
            </div>
        }

        <!-- 🛒 GESTIÓN COMERCIAL - COMPRAS (ADMIN + COMPRAS) -->
        @if (rolId == 1 || rolId == 6)
        {
            <div class="menu-modulo">
                <button class="menu-titulo">
                    <i class="bi bi-bag-check-fill"></i> Compras
                </button>

                <div class="menu-opciones">
                    <a asp-controller="Proveedore" asp-action="Index">
                        <i class="bi bi-truck"></i> Proveedores
                    </a>

                    <a asp-controller="Compra" asp-action="Index">
                        <i class="bi bi-bag-check"></i> Compras
                    </a>
                </div>
            </div>
        }

        <!-- 💰 GESTIÓN COMERCIAL - VENTAS (ADMIN + VENTAS) -->
        @if (rolId == 1 || rolId == 8)
        {
            <div class="menu-modulo">
                <button class="menu-titulo">
                    <i class="bi bi-cash-coin"></i> Ventas
                </button>

                <div class="menu-opciones">
                    <a asp-controller="Cliente" asp-action="Index">
                        <i class="bi bi-people"></i> Clientes
                    </a>

                    <a asp-controller="Venta" asp-action="Index">
                        <i class="bi bi-currency-dollar"></i> Ventas
                    </a>
                </div>
            </div>
        }

        <!-- ⚙️ CONFIGURACIÓN (SOLO ADMIN) -->
        @if (rolId == 1)
        {
            <div class="menu-modulo">
                <button class="menu-titulo">
                    <i class="bi bi-gear-fill"></i> Configuración
                </button>

                <div class="menu-opciones">
                    <a asp-controller="DatosNegocio" asp-action="Index">
                        <i class="bi bi-building-gear"></i> Datos del Negocio
                    </a>
                </div>
            </div>
        }

        @if (rolId == 1 || rolId == 6)
        {
            @* 🔔 ALERTAS *@
            <div class="px-3 mb-3">
                <div class="dropdown">

                    <a class="btn w-100 dropdown-toggle fw-bold"
                           href="#" role="button" data-bs-toggle="dropdown">

                        <i class="bi bi-bell-fill"></i> Alertas

                        @if (totalAlertas > 0)
                        {
                            <span class="badge bg-danger ms-2">@totalAlertas</span>
                        }
                    </a>

                    <ul class="dropdown-menu w-100">

                        @if (totalAlertas == 0)
                        {
                            <li class="dropdown-item text-muted">
                                <i class="bi bi-check-circle me-2"></i>
                                Sin alertas
                            </li>
                        }
                        else
                        {
                            @foreach (var item in productosBajoStock.Take(5))
                            {
                                <li>
                                    <a class="dropdown-item text-dark custom-item"
                                           asp-controller="Producto"
                                           asp-action="Details"
                                           asp-route-id="@item.Id">

                                        ⚠️ @item.Nombre
                                        <br />
                                        <small class="text-secondary">
                                            Stock: @item.Stock | Mín: @item.StockMinimo
                                        </small>
                                    </a>
                                </li>
                            }

                            <li><hr class="dropdown-divider" /></li>

                            <li>
                                <a class="dropdown-item text-center text-primary fw-bold"
                                       asp-controller="Producto"
                                       asp-action="Alertas">

                                    <i class="bi bi-eye"></i> Ver todos
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        }
        <hr style="border-color: rgba(255,255,255,0.3)" />

        @if (Context.Session.GetString("Usuario") != null)
        {
            <a asp-controller="Account" asp-action="Logout">
                <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
            </a>
        }
    </div>

    <!-- CONTENIDO -->
    <div class="content">
        <main>
            @RenderBody()
        </main>

        <footer>
            <p>&copy; 2026 - AgroMercado 🌱</p>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
<script>
    document.querySelectorAll(".menu-titulo").forEach(btn => {
        btn.addEventListener("click", () => {
            const opciones = btn.nextElementSibling;
            opciones.style.display =
                opciones.style.display === "flex" ? "none" : "flex";
        });
    });
</script>