@model Agro_Mercado.AppMVC.Models.Proveedore

<div class="form-create-container">

    <div class="form-create-card">

        <h4 class="titulo-agro mb-4">🌾 Nuevo Proveedor</h4>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row">

                
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control input-agro" placeholder="Nombre del proveedor" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                
                <div class="col-md-6 mb-3">
                    <label class="form-label">Teléfono</label>
                    
                    <input asp-for="Telefono" class="form-control input-agro" placeholder="Ej: 7777-7777" />
                    
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>

                
                <div class="col-md-12 mb-3">
                    <label class="form-label">Dirección</label>
                    
                    <input asp-for="Direccion" class="form-control input-agro" placeholder="Dirección completa" />
                    
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>

                
                <div class="col-md-6 mb-3">
                    <label class="form-label">NIT</label>
                    
                    <input asp-for="Nit" class="form-control input-agro" placeholder="Número de NIT" />
                    
                    <span asp-validation-for="Nit" class="text-danger"></span>
                </div>

                
                <div class="col-md-6 mb-3">
                    <label class="form-label">NRC</label>
                    
                    <input asp-for="Nrc" class="form-control input-agro" placeholder="Número NRC" />
                    
                    <span asp-validation-for="Nrc" class="text-danger"></span>
                </div>

                
                <div class="col-md-12 mb-3">
                    <label class="form-label">Correo Electrónico</label>
                    
                    <input asp-for="CorreoElectronico" class="form-control input-agro" placeholder="correo@ejemplo.com" />
                    
                    <span asp-validation-for="CorreoElectronico" class="text-danger"></span>
                </div>

                
                <div class="col-md-6 mb-3">
                    <label class="form-label">Activo</label>
                    <select asp-for="Activo" class="form-select input-agro" placeholder="-- Activo --">
                        <option value="true">Activo</option>
                        <option value="false">Inactivo</option>
                    </select>
                </div>

            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">

                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-plus-lg me-2"></i>Guardar
                </button>

                <a asp-action="Index" class="btn btn-secondary px-4">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </a>

            </div>

        </form>

    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}