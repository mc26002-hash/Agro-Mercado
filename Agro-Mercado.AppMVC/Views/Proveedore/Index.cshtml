@model IEnumerable<Agro_Mercado.AppMVC.Models.Proveedore>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title mb-3">Buscar Proveedores</h5>

            <form asp-controller="Proveedore" asp-action="Index" method="get">
                <div class="row">

                    
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted small">Nombre</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-truck text-primary"></i>
                            </span>
                            <input type="text" name="nombre" class="form-control"
                                   placeholder="Ej: Agro..." value="@Context.Request.Query["nombre"]" />
                        </div>
                    </div>

                    
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-muted small">Estado</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-toggle-on text-primary"></i>
                            </span>
                            <select name="activo" class="form-select">
                                <option value="">Todos</option>
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </select>
                        </div>
                    </div>

                   
                    <div class="col-md-2">
                        <label class="form-label fw-bold text-muted small">Cantidad</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-list-ol text-primary"></i>
                            </span>

                            <select name="topRegistro" class="form-select">

                                <option value="5">5</option>
                                <option value="10">10</option>
                                <option value="20">20</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                                <option value="0">Todos</option>

                            </select>
                        </div>
                    </div>

                </div>

               
                <div class="row mt-4">
                    <div class="col-12 d-flex gap-2">

                        <button type="submit" class="btn btn-primary px-4 shadow-sm fw-bold">
                            <i class="bi bi-search me-2"></i>Buscar
                        </button>

                        <a asp-action="Index" class="btn btn-secondary px-4 shadow-sm">
                            <i class="bi bi-eraser me-2"></i>Limpiar
                        </a>

                        <a asp-action="Create" class="btn btn-success px-4 shadow-sm">
                            <i class="bi bi-plus-lg me-2"></i>Nuevo Proveedor
                        </a>

                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

<!-- 🧾 TABLA -->
<table class="table table-bordered mt-4">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Teléfono</th>
            <th>Dirección</th>
            <th>NIT</th>
            <th>Estado</th>
            <th style="width: 240px;">Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Telefono</td>
                <td>@item.Direccion</td>
                <td>@item.Nit</td>

                <td>
                    @if (item.Activo == true)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                        Ver
                    </a>

                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>